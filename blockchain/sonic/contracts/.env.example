# ── Required ──
# Deployer private key (with or without 0x prefix)
PRIVATE_KEY=your_private_key_here

# ── Optional ──
# ERC-20 token address for staking (e.g. USDC). If empty, MockERC20 is deployed.
TOKEN_ADDRESS=

# Market owner address (defaults to deployer if not set)
OWNER_ADDRESS=

# Minimum stake in token base units (default: 1_000_000 = 1 USDC)
MIN_STAKE=1000000

# Resolution grace period in seconds (default: 86400 = 1 day)
GRACE_PERIOD=86400
